rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // HELPERS GLOBALES DE AUTORIZACIÓN Y ROLES (PED-06A)
    // ==========================================
    function isSignedIn() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDocRole() {
      return hasUserDoc()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol
        : null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        request.auth.token.rol in ['admin', 'administrador'] ||
        userDocRole() in ['admin', 'administrador']
      );
    }

    function isStaff() {
      return isAdmin() || (
        isSignedIn() && (
          request.auth.token.profesor == true ||
          request.auth.token.instructor == true ||
          request.auth.token.rol in ['profesor', 'instructor'] ||
          userDocRole() in ['profesor', 'instructor']
        )
      );
    }

    function isOwnerUserProfileUpdate() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return isSignedIn() &&
        request.auth.uid == resource.id &&
        changed.hasOnly([
          'nombre', 'foto_url', 'telefono', 'dni', 'genero', 'grupo_sanguineo',
          'fecha_nacimiento', 'contacto_emergencia_nombre',
          'contacto_emergencia_telefono', 'observaciones_medicas', 'updated_at',
          'fcm_token', 'notifications_enabled', 'hasSeenWalkthrough',
          'logros_celebrados', 'sede', 'status'
        ]) &&
        !('rol' in changed) &&
        !('corda' in changed) &&
        !('clase_id' in changed) &&
        !('fecha_inicio' in changed) &&
        !('uid' in changed) &&
        !('email' in changed) &&
        (
          !('status' in changed) ||
          request.resource.data.status == resource.data.status ||
          (resource.data.status == 'nuevo' && request.resource.data.status == 'prueba') ||
          (resource.data.status == 'activo' && request.resource.data.status == 'inactivo')
        );
    }

    // ==========================================
    // REGLA PARA PERFILES DE USUARIO Y NOTIFICACIONES (P0 RESUELTO)
    // ==========================================
    match /users/{userId} {
      // Solo el propietario de la cuenta o el staff (profesor/admin) puede leer un perfil con PII.
      allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());

      // Creación:
      // - Admin puede crear cualquier perfil
      // - Profesor/staff solo puede matricular alumnos ('rol == alumno')
      // - Usuario recién registrado solo puede crear su propio documento con rol 'alumno' y status 'nuevo'
      allow create: if isAdmin() ||
        (isStaff() && request.resource.data.rol == 'alumno') ||
        (
          isSignedIn() &&
          request.auth.uid == userId &&
          request.resource.data.rol == 'alumno' &&
          (!('status' in request.resource.data) || request.resource.data.status == 'nuevo') &&
          (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        );

      // Actualización:
      // - Admin puede actualizar cualquier perfil
      // - Profesor solo puede gestionar perfiles con rol 'alumno' sin elevar roles
      // - El propietario solo puede editar su ficha personal/UX/estado acotado (nunca rol, corda ni clase_id)
      allow update: if isAdmin() ||
        (
          isStaff() &&
          resource.data.rol == 'alumno' &&
          request.resource.data.rol == resource.data.rol
        ) ||
        (isSignedIn() && request.auth.uid == userId && isOwnerUserProfileUpdate());

      allow delete: if isAdmin();

      // Buzón de notificaciones:
      // - Solo dueño (o admin) lee, marca como leído o elimina
      // - Creación permitida para staff, o para el propio usuario/hacia staff con leido no marcado true
      match /notificaciones/{notificacionId} {
        allow read, update, delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
        allow create: if isSignedIn() && (
          isStaff() ||
          (
            (
              request.auth.uid == userId ||
              (
                exists(/databases/$(database)/documents/users/$(userId)) &&
                get(/databases/$(database)/documents/users/$(userId)).data.rol in ['profesor', 'instructor', 'admin', 'administrador']
              )
            ) &&
            (!('leido' in request.resource.data) || request.resource.data.leido == false)
          )
        );
      }

      // Registro de compensaciones de membresía (feriados, inasistencias, congelar)
      match /compensaciones/{compensacionId} {
        allow read: if isSignedIn() && (request.auth.uid == userId || isStaff());
        allow write: if isStaff();
      }
    }

    // ==========================================
    // REGLA PARA LA TIENDA Y PEDIDOS (P0 RESUELTO)
    // ==========================================
    match /productos/{productId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /pedidos/{pedidoId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      allow create: if isStaff() || (
        isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.status == 'pendiente' &&
        request.resource.data.items is list &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0
      );
      allow update, delete: if isStaff();
    }

    // ==========================================
    // REGLAS PARA CLASES, ASISTENCIAS, RESERVAS Y SESIONES QR (P0 RESUELTO)
    // ==========================================
    match /clases/{claseId} {
      allow read: if isSignedIn();
      allow create, delete: if isStaff();
      // El alumno solo puede decrementar cupos_disponibles en exactamente 1 al reservar clase de prueba,
      // de forma atómica con su transición users/{uid}.status ('nuevo' -> 'prueba').
      allow update: if isStaff() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cupos_disponibles']) &&
        request.resource.data.cupos_disponibles is int &&
        resource.data.cupos_disponibles is int &&
        request.resource.data.cupos_disponibles == resource.data.cupos_disponibles - 1 &&
        request.resource.data.cupos_disponibles >= 0 &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'nuevo' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'prueba'
      );
    }

    match /asistencias/{asistenciaId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      // El alumno solo puede registrar SU propia asistencia única (${sesion_id}_${uid}) contra una sesión QR activa y coherente.
      allow create: if isStaff() || (
        isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.sesion_id is string &&
        request.resource.data.sesion_id.size() > 0 &&
        asistenciaId == request.resource.data.sesion_id + '_' + request.auth.uid &&
        exists(/databases/$(database)/documents/sesiones/$(request.resource.data.sesion_id)) &&
        get(/databases/$(database)/documents/sesiones/$(request.resource.data.sesion_id)).data.activa == true &&
        request.resource.data.clase_id == get(/databases/$(database)/documents/sesiones/$(request.resource.data.sesion_id)).data.clase_id &&
        request.resource.data.fecha == get(/databases/$(database)/documents/sesiones/$(request.resource.data.sesion_id)).data.fecha
      );
      allow update, delete: if isStaff();
    }

    match /reservas/{reservaId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      allow create: if isStaff() || (
        isSignedIn() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.status == 'confirmado' &&
        request.resource.data.clase_id is string &&
        request.resource.data.clase_id.size() > 0 &&
        exists(/databases/$(database)/documents/clases/$(request.resource.data.clase_id))
      );
      allow update: if isStaff() || (
        isSignedIn() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['asistido', 'cancelado']
      );
      allow delete: if isStaff();
    }

    match /sesiones/{sesionId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    // ==========================================
    // REGLA PARA PAGOS Y CONFIGURACIÓN DEL NEGOCIO
    // ==========================================
    match /pagos/{pagoId} {
      allow read: if isSignedIn() && (resource.data.user_id == request.auth.uid || isStaff());
      allow write: if isStaff();
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ==========================================
    // REGLA PARA BIBLIOTECA, CANCIONERO Y EVENTOS (P0 RESUELTO)
    // ==========================================
    match /tutoriales/{tutorialId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /cantigas/{cantigaId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /eventos/{eventId} {
      allow read: if isSignedIn();
      allow write: if isStaff();

      match /registros/{userId} {
        allow read, create, update: if isSignedIn() && (request.auth.uid == userId || isStaff());
        allow delete: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      }
    }

    // ==========================================
    // REGLAS DEL PLANIFICADOR PEDAGÓGICO Y PIZARRA (PED-05 / PED-06A)
    // ==========================================
    function isPlannerAdmin() {
      return isAdmin();
    }

    function isPlannerInstructor() {
      return isStaff();
    }

    function isValidPlanStatus(status) {
      return status in ['draft', 'saved', 'planned', 'in_progress', 'completed', 'archived'];
    }

    match /instructor_ideas/{ideaId} {
      allow read: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid ||
        resource.data.shared == true ||
        !('instructor_id' in resource.data)
      );
      allow create: if isPlannerInstructor() &&
        request.resource.data.instructor_id == request.auth.uid &&
        request.resource.data.titulo is string &&
        request.resource.data.titulo.size() > 0;
      allow update: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid ||
        !('instructor_id' in resource.data)
      ) &&
        request.resource.data.instructor_id == (
          ('instructor_id' in resource.data) ? resource.data.instructor_id : request.auth.uid
        );
      allow delete: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid
      );
    }

    match /instructor_planes_clase/{planId} {
      allow read: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid ||
        !('instructor_id' in resource.data)
      );
      allow create: if isPlannerInstructor() &&
        request.resource.data.instructor_id == request.auth.uid &&
        request.resource.data.titulo is string &&
        request.resource.data.titulo.size() > 0 &&
        request.resource.data.duracion_total is int &&
        request.resource.data.duracion_total > 0 &&
        (!('plan_status' in request.resource.data) || isValidPlanStatus(request.resource.data.plan_status)) &&
        (!('revision' in request.resource.data) || (request.resource.data.revision is int && request.resource.data.revision >= 1));
      allow update: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid ||
        !('instructor_id' in resource.data)
      ) &&
        request.resource.data.instructor_id == (
          ('instructor_id' in resource.data) ? resource.data.instructor_id : request.auth.uid
        ) &&
        (!('plan_status' in request.resource.data) || isValidPlanStatus(request.resource.data.plan_status)) &&
        (!('revision' in request.resource.data) || (request.resource.data.revision is int && request.resource.data.revision >= 1));
      allow delete: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid
      );
    }

    match /instructor_sesiones_activas/{activeSessionId} {
      allow read, delete: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid
      );
      allow create, update: if isPlannerInstructor() &&
        request.resource.data.instructor_id == request.auth.uid &&
        request.resource.data.plan_id is string &&
        request.resource.data.plan_id.size() > 0 &&
        request.resource.data.started_at is string &&
        request.resource.data.started_at.size() > 0;
    }

    match /instructor_sesiones_impartidas/{sessionId} {
      allow read: if isPlannerInstructor() && (
        isPlannerAdmin() ||
        resource.data.instructor_id == request.auth.uid
      );
      allow create: if isPlannerInstructor() &&
        request.resource.data.instructor_id == request.auth.uid &&
        request.resource.data.session_id == sessionId &&
        request.resource.data.plan_id is string &&
        request.resource.data.plan_id.size() > 0 &&
        request.resource.data.plan_snapshot is map &&
        (
          request.resource.data.ended_at is string ||
          request.resource.data.ended_at is timestamp ||
          request.resource.data.completed_at is string
        );
      allow update, delete: if false;
    }

    match /planner_v2_quotas/{quotaDocId} {
      allow read, write: if false;
    }
    match /planner_ai_usage/{docId} {
      allow read, write: if false;
    }
    match /planner_ai_requests/{docId} {
      allow read, write: if false;
    }
    match /planner_copilot_usage/{docId} {
      allow read, write: if false;
    }
    match /planner_copilot_requests/{docId} {
      allow read, write: if false;
    }

    // ==========================================
    // REGLA PARA LEADS Y MENSAJES DE WHATSAPP (P0 RESUELTO)
    // ==========================================
    match /whatsapp_leads/{leadId} {
      allow read, write: if isStaff();
      match /mensajes/{msgId} {
        allow read, write: if isStaff();
      }
    }

    // ==========================================
    // REGLA PARA FEEDBACK Y EVALUACIONES DEL AGENTE IA GINGA 🤖
    // ==========================================
    match /agent_feedback/{feedbackId} {
      function isTeacherOrAdmin() {
        return isStaff();
      }

      // 1. LECTURA: Solo profesores o administradores autenticados
      allow read: if isTeacherOrAdmin();

      // 2. CREACIÓN:
      // - Requiere rol profesor o admin autenticado
      // - Prohíbe suplantar al autor (reported_by.uid debe coincidir con request.auth.uid)
      // - Estado inicial OBLIGATORIO: 'reported'
      // - Validación estricta de presencia y tipo de campos requeridos
      allow create: if isTeacherOrAdmin() &&
        request.resource.data.reported_by.uid == request.auth.uid &&
        request.resource.data.status == 'reported' &&
        request.resource.data.feedback_id is string && request.resource.data.feedback_id.size() > 0 &&
        request.resource.data.lead_id is string && request.resource.data.lead_id.size() > 0 &&
        request.resource.data.message_id is string && request.resource.data.message_id.size() > 0 &&
        request.resource.data.category in [
          'interpretacion_ambiguedad', 'informacion_comercial', 'captacion_datos',
          'reserva_reprogramacion', 'persistencia_contexto', 'herramientas_operaciones',
          'derivacion_humana', 'experiencia_conversacional', 'otro'
        ] &&
        request.resource.data.severity in ['baja', 'media', 'alta', 'critica'] &&
        request.resource.data.observation is string && request.resource.data.observation.size() > 0 &&
        request.resource.data.expected_behavior is string && request.resource.data.expected_behavior.size() > 0 &&
        request.resource.data.actual_behavior is string &&
        request.resource.data.reported_at is timestamp;

      // 3. ACTUALIZACIÓN / TRIAJE:
      // - Requiere rol profesor o admin
      // - CAMPOS DE AUDITORÍA INMUTABLES: no se permite alterar id, lead, mensaje, autor, fecha ni contenido original
      // - PRIVILEGIOS DE ESTADO: Solo un 'admin'/'administrador' puede marcar incidencias como 'approved', 'deployed' o 'closed'
      allow update: if isTeacherOrAdmin() &&
        request.resource.data.feedback_id == resource.data.feedback_id &&
        request.resource.data.lead_id == resource.data.lead_id &&
        request.resource.data.message_id == resource.data.message_id &&
        request.resource.data.reported_by.uid == resource.data.reported_by.uid &&
        request.resource.data.reported_at == resource.data.reported_at &&
        request.resource.data.actual_behavior == resource.data.actual_behavior &&
        request.resource.data.category == resource.data.category &&
        (
          (request.resource.data.status in ['reported', 'triaged', 'reproduced', 'fix_proposed', 'validated', 'rejected', 'needs_information']) ||
          (request.resource.data.status in ['approved', 'deployed', 'closed'] && isAdmin())
        );

      // 4. ELIMINACIÓN: Terminantemente PROHIBIDO borrar incidencias (inmutabilidad y auditoría)
      allow delete: if false;
    }

    match /agent_evaluations/{caseId} {
      allow read: if isStaff();

      allow create, update: if isStaff() &&
        request.resource.data.case_id is string && request.resource.data.case_id.size() > 0 &&
        request.resource.data.category is string &&
        request.resource.data.scenario is string &&
        request.resource.data.created_at is timestamp;

      allow delete: if false;
    }

    // ==========================================
    // REGLAS PARA EL CATÁLOGO CURRICULAR FIU (PED-03A)
    // Lectura unificada para usuarios autenticados;
    // escritura estrictamente administrativa por Custom Claims; borrado bloqueado.
    // ==========================================
    function isCurriculumAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.curriculum_admin == true
      );
    }

    match /curriculum_meta/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.catalog_id is string &&
        request.resource.data.schema_version is string;
      allow delete: if false;
    }

    match /curriculum_movements/{movementId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.movement_id == movementId &&
        request.resource.data.canonical_name is string &&
        request.resource.data.canonical_name.size() > 0 &&
        request.resource.data.category_id in [
          'fundamento', 'golpe_de_ataque', 'saida_esquiva',
          'movimento_de_solo', 'golpe_desequilibrante'
        ] &&
        request.resource.data.review_status in ['approved', 'pending_technical_review'] &&
        request.resource.data.is_ambiguous is bool &&
        request.resource.data.ai_planner_eligible is bool;
      allow delete: if false;
    }

    match /curriculum_cordas/{cordaId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.corda_id == cordaId &&
        request.resource.data.track_id in ['adulto', 'infantil'] &&
        request.resource.data.index is int &&
        request.resource.data.nombre_manual is string;
      allow delete: if false;
    }

    match /curriculum_blocks/{blockId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.block_id == blockId &&
        request.resource.data.track_id in ['adulto', 'infantil'] &&
        request.resource.data.corda_ids is list;
      allow delete: if false;
    }

    match /curriculum_tutorial_links/{linkId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.tutorial_doc_id == linkId &&
        request.resource.data.movement_ids is list;
      allow delete: if false;
    }

    match /curriculum_glossary_links/{linkId} {
      allow read: if isSignedIn();
      allow create, update: if isCurriculumAdmin() &&
        request.resource.data.termino_glosario is string &&
        request.resource.data.movement_ids is list;
      allow delete: if false;
    }

    // Denegación explícita por defecto para cualquier colección no listada.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
